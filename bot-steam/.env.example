# Copia este archivo como ".env" EN EL SERVIDOR (nunca lo subas a GitHub) y completa los datos.

# Cuenta de Steam del bot
STEAM_USUARIO=bryanmax007
STEAM_CLAVE=pon_aqui_la_contraseña

# Archivo del autenticador que creó Steam Desktop Authenticator (carpeta maFiles)
MAFILE=secretos/bot.maFile

# Llave de la cuenta de servicio de Firebase (Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada)
FIREBASE_CREDENCIALES=secretos/firebase.json

# Horas que una oferta sin respuesta queda abierta antes de cancelarse sola
VENCER_OFERTA_HORAS=48

# Vender skins: lista de precios de compra del panel del bot LIS (mismo servidor). Se sube a Firestore cada hora.
# Déjalo vacío (PRECIOS_COMPRA_URL=) para no sincronizar.
PRECIOS_COMPRA_URL=http://127.0.0.1:8787/api/precios-compra
